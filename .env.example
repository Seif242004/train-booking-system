# Copy to .env and fill in every value. .env is git-ignored; only this file is committed.

# Oracle admin password (SYS, SYSTEM, PDBADMIN). Used by the init script only.
ORACLE_PASSWORD=

# One password per schema. Do not use a double quote in a password.
TRAIN_SCHEDULE_DB_PASSWORD=
BOOKING_SEAT_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
TICKET_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Keycloak bootstrap admin (master realm console).
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Passwords of the two dev users in the train-booking realm (dev.user@example.com, dev.admin@example.com).
KEYCLOAK_DEV_USER_PASSWORD=
KEYCLOAK_DEV_ADMIN_PASSWORD=
