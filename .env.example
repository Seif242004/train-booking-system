# Copy to .env and fill in every value. .env is git-ignored; only this file is committed.

# Oracle admin password (SYS, SYSTEM, PDBADMIN). Used by the init script only.
ORACLE_PASSWORD=

# One password per schema. Do not use a double quote in a password.
TRAIN_SCHEDULE_DB_PASSWORD=
BOOKING_SEAT_DB_PASSWORD=
# Optional: only for the Booking & Seat database tests. Leave empty to not create that schema (the tests are then skipped).
BOOKING_SEAT_TEST_DB_PASSWORD=
# Optional: only for the Payment database tests. Leave empty to not create that schema (the tests are then skipped).
PAYMENT_TEST_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
# Optional: only for the Ticket database tests. Leave empty to not create that schema (the tests are then skipped).
TICKET_TEST_DB_PASSWORD=
TICKET_DB_PASSWORD=
# Optional: only for the Notification database tests. Leave empty to not create that schema (the tests are then skipped).
NOTIFICATION_TEST_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Keycloak bootstrap admin (master realm console).
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Passwords of the two dev users in the train-booking realm (dev.user@example.com, dev.admin@example.com).
KEYCLOAK_DEV_USER_PASSWORD=
KEYCLOAK_DEV_ADMIN_PASSWORD=

# Stripe, TEST MODE ONLY (https://dashboard.stripe.com/test/apikeys). The Payment service refuses to start with a live key.
# STRIPE_WEBHOOK_SECRET is the whsec_... printed by the Stripe CLI of the dev profile (see docker-compose.yml).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared key for service-to-service calls (/internal/**). One random string for all services in the Compose stack.
INTERNAL_API_KEY=
# Signs the token in the QR code of every ticket (HMAC-SHA256). A long random string; changing it makes old QR codes unverifiable.
TICKET_SIGNING_KEY=

# OpenObserve (logs, traces, audit trail): the root login of its web UI (http://localhost:5080) and of the services that send to it.
# The user must look like an email address.
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=

# Optional: a real SMTP server for the Notification service. Without these it sends to Mailpit (profile "dev").
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_AUTH=
# MAIL_STARTTLS=
