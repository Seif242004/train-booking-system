# Key names and purposes only. The real values live in .env (git-ignored) and never in this file, in a comment or in a commit.
# docker-compose.yml reads this file for the containers; the Spring services started by Gradle on the host read the same names from
# the process environment or from services/<name>/.env (spring.config.import in their application.properties).
# Copy to .env and fill in every value. .env is git-ignored; only this file is committed.

# Oracle admin password (SYS, SYSTEM, PDBADMIN). Used by the init script only.
ORACLE_PASSWORD=

# One password per schema. Do not use a double quote in a password.
# Password of the database user "train_schedule", used by Train & Schedule and by Flyway (its migrations).
TRAIN_SCHEDULE_DB_PASSWORD=
# Password of the database user "booking_seat" (Booking & Seat).
BOOKING_SEAT_DB_PASSWORD=
# Optional: only for the Booking & Seat database tests. Leave empty to not create that schema (the tests are then skipped).
BOOKING_SEAT_TEST_DB_PASSWORD=
# Optional: only for the Payment database tests. Leave empty to not create that schema (the tests are then skipped).
PAYMENT_TEST_DB_PASSWORD=
# Password of the database user "payment" (Payment).
PAYMENT_DB_PASSWORD=
# Optional: only for the Ticket database tests. Leave empty to not create that schema (the tests are then skipped).
TICKET_TEST_DB_PASSWORD=
# Password of the database user "ticket" (Ticket).
TICKET_DB_PASSWORD=
# Optional: only for the Notification database tests. Leave empty to not create that schema (the tests are then skipped).
NOTIFICATION_TEST_DB_PASSWORD=
# Password of the database user "notification" (Notification).
NOTIFICATION_DB_PASSWORD=
# Password of the database user "keycloak" (Keycloak's own tables; Keycloak runs on Oracle too).
KEYCLOAK_DB_PASSWORD=

# Keycloak bootstrap admin (master realm console).
# Login of the administrator of Keycloak's admin console (http://localhost:8180). Created on the first start only.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Passwords of the two dev users in the train-booking realm (dev.user@example.com, dev.admin@example.com).
# Passwords written into the realm when it is imported (the placeholders in infra/keycloak/realm-dev.json). The development
# accounts are for local use only. Changing them later in .env does nothing until the realm is imported again (docker compose down -v).
KEYCLOAK_DEV_USER_PASSWORD=
KEYCLOAK_DEV_ADMIN_PASSWORD=

# Stripe, TEST MODE ONLY (https://dashboard.stripe.com/test/apikeys). The Payment service refuses to start with a live key.
# STRIPE_WEBHOOK_SECRET is the whsec_... printed by the Stripe CLI of the dev profile (see docker-compose.yml).
# Publishable key (pk_test_...): public by design, handed to the browser to show Stripe's card form.
# Secret key (sk_test_...): only the Payment service uses it to create payments and refunds. Webhook secret (whsec_...): checks the
# signature of the events Stripe sends to POST /webhooks/payment.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared key for service-to-service calls (/internal/**). One random string for all services in the Compose stack.
# Sent as the header X-Internal-Api-Key on every service-to-service call. A service does not start without it.
INTERNAL_API_KEY=
# Signs the token in the QR code of every ticket (HMAC-SHA256). A long random string; changing it makes old QR codes unverifiable.
# Used only by the Ticket service.
TICKET_SIGNING_KEY=

# OpenObserve (logs, traces, audit trail): the root login of its web UI (http://localhost:5080) and of the services that send to it.
# The user must look like an email address.
# Used twice: OpenObserve creates its root account from it, and every service logs in with it to send logs and traces.
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=

# Optional: a real SMTP server for the Notification service. Without these it sends to Mailpit (profile "dev").
# MAIL_HOST and MAIL_PORT: address of the SMTP server. MAIL_USERNAME and MAIL_PASSWORD: its login. MAIL_AUTH: "true" if it needs a login.
# MAIL_STARTTLS: "true" to upgrade the connection to TLS. Mailpit needs none of them.
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_AUTH=
# MAIL_STARTTLS=
