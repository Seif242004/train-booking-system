# Copy to .env to override. Every value has the default shown here, so the Gateway also runs without a .env file.

PORT=8080
HOST=127.0.0.1

# The realm's issuer URL. The JWKS (public keys) are fetched from <issuer>/protocol/openid-connect/certs.
# Tokens are accepted only if their `iss` claim equals this value exactly.
KEYCLOAK_ISSUER=http://localhost:8180/realms/train-booking

# The only browser origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173
