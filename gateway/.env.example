# Copy to .env to override. Every value has the default shown here, so the Gateway also runs without a .env file.

PORT=8080
HOST=127.0.0.1

# The realm's issuer URL. The JWKS (public keys) are fetched from <issuer>/protocol/openid-connect/certs.
# Tokens are accepted only if their `iss` claim equals this value exactly.
KEYCLOAK_ISSUER=http://localhost:8180/realms/train-booking

# The only browser origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Backend services the Gateway forwards to, and how long it waits for an answer.
TRAIN_SCHEDULE_URL=http://localhost:8081
BOOKING_SEAT_URL=http://localhost:8082
PAYMENT_URL=http://localhost:8083
UPSTREAM_TIMEOUT_MS=10000

# How long to wait for Booking & Seat per trip in the search results before showing the trip without its availability.
AVAILABILITY_TIMEOUT_MS=3000
