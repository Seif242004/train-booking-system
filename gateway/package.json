{
  "name": "gateway",
  "version": "0.0.1",
  "private": true,
  "description": "API Gateway: single entry point that verifies the Keycloak JWT and enforces roles",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "jose": "6.2.12"
  }
}
