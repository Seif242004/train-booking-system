# Copy to .env and fill in the values. .env is git-ignored; only this file is committed.

# Password of the booking_seat Oracle user (the same value as BOOKING_SEAT_DB_PASSWORD in the root .env).
BOOKING_SEAT_DB_PASSWORD=

# Password of the booking_seat_test Oracle user used by the database tests (the same value as
# BOOKING_SEAT_TEST_DB_PASSWORD in the root .env). Without it the database tests are skipped.
BOOKING_SEAT_TEST_DB_PASSWORD=

# Shared key for service-to-service calls (the same value in Train & Schedule's .env). Generate a long random string.
INTERNAL_API_KEY=

# Optional overrides; the defaults are for the local Compose stack.
# BOOKING_SEAT_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# BOOKING_SEAT_DB_USER=booking_seat
# BOOKING_SEAT_TEST_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# BOOKING_SEAT_TEST_DB_USER=booking_seat_test
# KEYCLOAK_ISSUER=http://localhost:8180/realms/train-booking
