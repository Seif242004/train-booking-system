# Copy to .env and fill in the values. .env is git-ignored; only this file is committed.

# Password of the notification Oracle user (the same value as NOTIFICATION_DB_PASSWORD in the root .env).
NOTIFICATION_DB_PASSWORD=

# Password of the notification_test Oracle user used by the database tests (the same value as NOTIFICATION_TEST_DB_PASSWORD in the root .env).
# Without it the database tests are skipped.
NOTIFICATION_TEST_DB_PASSWORD=

# Shared key for service-to-service calls (the same value in Booking & Seat's .env). Generate a long random string.
INTERNAL_API_KEY=

# SMTP. The defaults are Mailpit of the dev profile of Compose (SMTP on 1025, web UI on http://localhost:8025).
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_AUTH=false
# MAIL_STARTTLS=false
# MAIL_FROM=tickets@trainbooking.local
# TIMEZONE=Africa/Cairo
# NOTIFICATION_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# NOTIFICATION_DB_USER=notification
