# Copy to .env and fill in the values. .env is git-ignored; only this file is committed.

# Password of the payment Oracle user (the same value as PAYMENT_DB_PASSWORD in the root .env).
PAYMENT_DB_PASSWORD=

# Password of the payment_test Oracle user used by the database tests (the same value as
# PAYMENT_TEST_DB_PASSWORD in the root .env). Without it the database tests are skipped.
PAYMENT_TEST_DB_PASSWORD=

# Shared key for service-to-service calls (the same value in Booking & Seat's .env). Generate a long random string.
INTERNAL_API_KEY=

# Stripe, in test mode (https://dashboard.stripe.com/test/apikeys). Without the secret key the service starts but every call that
# needs Stripe answers 503. The webhook secret comes from `stripe listen --forward-to localhost:8080/webhooks/payment` or from the
# webhook endpoint in the dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional overrides; the defaults are for the local Compose stack.
# PAYMENT_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# PAYMENT_DB_USER=payment
# BOOKING_SEAT_URL=http://localhost:8082
