# Copy to .env and fill in the values. .env is git-ignored; only this file is committed.

# Password of the ticket Oracle user (the same value as TICKET_DB_PASSWORD in the root .env).
TICKET_DB_PASSWORD=

# Password of the ticket_test Oracle user used by the database tests (the same value as TICKET_TEST_DB_PASSWORD in the root .env).
# Without it the database tests are skipped.
TICKET_TEST_DB_PASSWORD=

# Shared key for service-to-service calls (the same value in Booking & Seat's .env). Generate a long random string.
INTERNAL_API_KEY=

# Signs the token in the QR code of every ticket (HMAC-SHA256). Generate a long random string; changing it makes old QR codes unverifiable.
TICKET_SIGNING_KEY=

# Optional overrides; the defaults are for the local Compose stack.
# TICKET_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# TICKET_DB_USER=ticket
# TIMEZONE=Africa/Cairo
