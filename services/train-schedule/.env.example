# Copy to .env and fill in the password. .env is git-ignored; only this file is committed.

# Password of the train_schedule Oracle user (the same value as TRAIN_SCHEDULE_DB_PASSWORD in the root .env).
TRAIN_SCHEDULE_DB_PASSWORD=

# Optional overrides; the defaults are for the local Compose stack.
# TRAIN_SCHEDULE_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# TRAIN_SCHEDULE_DB_USER=train_schedule
# KEYCLOAK_ISSUER=http://localhost:8180/realms/train-booking
